{
 "id": "humanoid-21",
 "version": 1,
 "schema": "rigpilot.rig@1",
 "conventions": {
  "unit": "m",
  "upAxis": "+Y",
  "forwardAxis": "+Z",
  "leftAxis": "+X",
  "handedness": "right-handed",
  "floor": "Y = 0",
  "restPose": "T-pose, identity rest rotation for every joint, palms down, feet flat",
  "offsetSpace": "parent-local, which under the identity rest equals worldRest(child)-worldRest(parent)",
  "dofOrder": [
   "flex",
   "side",
   "twist"
  ],
  "dofCompose": "local = R(flex) * R(side) * R(twist) -- twist INNERMOST, so it is a roll about the rest bone axis and then gets carried by the swing. The reverse order (twist outermost) rotates about an axis the bone no longer lies on, so a pure humerus roll would drag the elbow through space: twist must never move a joint that sits on the bone axis. core/test/fk.test.ts asserts exactly this.",
  "limits": "relative to the T-pose rest; authored in degrees on semantic axes, never raw quaternions",
  "mirroring": "right-side axes are generated from the left by axis (nx,ny,nz)->(nx,-ny,-nz), angle unchanged",
  "notSameAsGlTF": "glTF is -Z forward: export wraps the rig in a parent node yawed by pi rather than rewriting every root key, so the exported root track stays numerically equal (VISION \u00a74 says 'same as glTF' \u2014 that parenthetical is wrong, see docs/RECONCILIATION.md)"
 },
 "root": {
  "joint": "hips",
  "restPosition": [
   0.0,
   0.98,
   0.0
  ],
  "degreesOfFreedom": "position xyz + heading + tilt{flex,side}",
  "note": "the root's height lives HERE, not in an offset: parent is null, so FK starts from rootKeys.position. VISION \u00a75.1 lists hips at y=0.98 \u2014 that number has to be stored somewhere or get_rig cannot return it and the rest pose cannot be rebuilt."
 },
 "stats": {
  "nodes": 26,
  "articulatingJoints": 21,
  "endSites": 5,
  "bones": 22,
  "contactMarkers": 6,
  "hierarchyEdges": 25,
  "bonesSinkingAtRest": [
   "foot_L",
   "foot_R",
   "toe_bone_L",
   "toe_bone_R"
  ],
  "note": "25 hierarchy edges, 22 cylinders: chest->clavicle_{L,R} and head->head_end have no drawn bone (the clavicle sits inside upper_chest, the skull is one sphere)"
 },
 "bindHeight": 1.8,
 "proportions": {
  "height": 1.8,
  "span": 1.96,
  "spanOverHeight": 1.089,
  "legLength": 0.95,
  "armLength": 0.79,
  "crown": 1.8,
  "band": {
   "spanOverHeight": [
    0.95,
    1.05
   ],
   "legOverHeight": [
    0.51,
    0.55
   ]
  },
  "warning": "span/height 1.089 is outside the band: fingertip span 1.96 m on a 1.80 m character. shoulder_* at \u00b10.19 is the deltoid, the glenohumeral centre is \u2248\u00b10.17. Cosmetic in the viewer, but this ratio is what a retargeter sanity-checks on an imported rig."
 },
 "mesh": {
